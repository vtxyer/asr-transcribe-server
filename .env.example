# Node.js >= 22 and ffmpeg are required.
# Copy to .env. Generate your own API key: openssl rand -hex 32
# The server refuses to start with an empty API key.
MUSE_API_KEY=

# Set an upstream Muse token here, or use MUSE_TOKEN_FILE for a token file.
# Token files are reread on each request so credentials can be refreshed.
MUSE_TOKEN=
MUSE_TOKEN_FILE=

HOST=127.0.0.1
PORT=10005
OPENCC_TARGET=twp
MUSE_SPEED=4
MUSE_MAX_AUDIO_SECONDS=600
MUSE_MAX_UPLOAD=209715200
MUSE_TIMEOUT_MS=120000
MUSE_RETRIES=1
MUSE_MODEL=prod_hatch_android
MUSE_MODE=PUSH_TO_TALK
