# Node.js >= 22 and ffmpeg are required.
# Copy to .env. Generate your own API key: openssl rand -hex 32
# The server refuses to start with an empty API key.
MUSE_API_KEY=

# Set an upstream Muse token here, or use MUSE_TOKEN_FILE for a token file.
# Token files are reread on each request so credentials can be refreshed.
MUSE_TOKEN=
MUSE_TOKEN_FILE=

# Requests whose model contains "scribe" (case-insensitive) use ElevenLabs Scribe V2.
# All other model names, including an omitted model, continue to use Muse.
ELEVENLABS_API_KEY=

HOST=127.0.0.1
PORT=10005
OPENCC_TARGET=twp
MUSE_SPEED=4
MUSE_MAX_AUDIO_SECONDS=600
MUSE_MAX_UPLOAD=209715200
MUSE_TIMEOUT_MS=120000
MUSE_RETRIES=1
MUSE_MODEL=prod_hatch_android
MUSE_MODE=PUSH_TO_TALK

# ── 豆包輸入法 ASR（model 名稱含 doubao 時使用） ─────────────────────
# 匿名裝置註冊，不用帳號。憑證檔第一次使用時自動產生；
# 刪掉就會換一台新裝置（後端偶爾會讓某台裝置失效，換一台就好）。
DOUBAO_CREDENTIAL_PATH=
DOUBAO_TIMEOUT_MS=
DOUBAO_RETRIES=
